{
  "name": "@nexo/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ALt.nexo — IDE visual orientada a agentes (app desktop)",
  "author": "ALt.",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --win --x64",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "^26.15.3"
  },
  "productName": "ALt.nexo",
  "build": {
    "appId": "br.app.alt.nexo",
    "productName": "ALt.nexo",
    "copyright": "ALt.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/**/*.map"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ALt.nexo",
      "artifactName": "ALt.nexo-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ALt.nexo-Portable-${version}.${ext}"
    }
  }
}